# Copy to .env (never commit .env) and fill in real values.

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/parkshare
SPRING_DATASOURCE_USERNAME=parkshare
SPRING_DATASOURCE_PASSWORD=change-me

# --- Security ---
# At least 32 characters. Generate one with: openssl rand -base64 48
PARKSHARE_JWT_SECRET=
# Optional separate secret for QR codes (defaults to the JWT secret)
PARKSHARE_QR_SECRET=
# Frontend origins allowed to call the API (comma-separated)
PARKSHARE_SECURITY_ALLOWEDORIGINS=http://localhost:3000,http://localhost:5173
# Login: short access tokens, long rotating refresh tokens
PARKSHARE_SECURITY_ACCESSTOKENMINUTES=30
PARKSHARE_SECURITY_REFRESHTOKENDAYS=30
# Optional: first admin account, created on startup if it does not exist (password >= 12 chars)
PARKSHARE_SECURITY_ADMINEMAIL=
PARKSHARE_SECURITY_ADMINPASSWORD=
PARKSHARE_SECURITY_ADMINPHONE=+250780000000

# --- Payments ---
# "sandbox" simulates MTN MoMo / Airtel Money until real provider adapters are added
PARKSHARE_PAYMENTS_PROVIDER=sandbox
# Shared secret for HMAC-SHA256 signatures on POST /api/payments/callback/{provider}
PARKSHARE_PAYMENTS_WEBHOOKSECRET=
# Set to false in production
PARKSHARE_PAYMENTS_SANDBOXENDPOINTSENABLED=true
# Sandbox: seconds before the simulated phone answers (0 = answer manually).
# Test numbers: ending 000 = declined, ending 999 = never answers, others = approved.
PARKSHARE_PAYMENTS_SANDBOXAUTOAPPROVESECONDS=5
# Merchant fee rates from your MTN / Airtel contracts (deducted from operator payout)
PARKSHARE_PAYMENTS_MTNMOMOFEERATE=0.015
PARKSHARE_PAYMENTS_AIRTELMONEYFEERATE=0.018

# --- Messages (SMS, email, OTP) ---
# "log" prints messages to the server log (free, for testing). Switch when ready:
PARKSHARE_MESSAGING_SMSPROVIDER=log
# PARKSHARE_MESSAGING_SMSPROVIDER=africastalking
# PARKSHARE_MESSAGING_AFRICASTALKING_USERNAME=sandbox
# PARKSHARE_MESSAGING_AFRICASTALKING_APIKEY=
# PARKSHARE_MESSAGING_AFRICASTALKING_SENDERID=
PARKSHARE_MESSAGING_EMAILPROVIDER=log
# PARKSHARE_MESSAGING_EMAILPROVIDER=smtp   (Brevo free: 300 emails/day)
# SPRING_MAIL_HOST=smtp-relay.brevo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Which events also go by SMS (each SMS costs money)
PARKSHARE_MESSAGING_SMSEVENTS=RESERVATION_CONFIRMED,RESERVATION_CANCELLED
PARKSHARE_MESSAGING_VERIFYPHONEONREGISTER=true

# --- Pricing (RWF; defaults shown, all optional) ---
PARKSHARE_PRICING_DEFAULTHOURLYRATE=300
PARKSHARE_PRICING_DEFAULTDAILYCAP=3000
PARKSHARE_PRICING_MINIMUMCHARGE=200
PARKSHARE_PRICING_BILLINGINCREMENTMINUTES=30
PARKSHARE_PRICING_ROUNDINGSTEP=10
PARKSHARE_PRICING_MAXHOURLYRATE=2000
PARKSHARE_PRICING_MAXDAILYRATE=20000
PARKSHARE_PRICING_PLATFORMCOMMISSIONRATE=0.10
PARKSHARE_PRICING_OVERSTAYGRACEMINUTES=10

# --- Tax (Rwanda VAT) ---
PARKSHARE_TAX_VATRATE=0.18
PARKSHARE_TAX_PRICESINCLUDEVAT=true

# --- Reservation rules ---
PARKSHARE_RESERVATION_PAYMENTHOLDMINUTES=15
PARKSHARE_RESERVATION_FREECANCELLATIONMINUTES=60
PARKSHARE_RESERVATION_LATECANCELLATIONREFUNDRATE=0.50
PARKSHARE_RESERVATION_NOSHOWGRACEMINUTES=30
PARKSHARE_RESERVATION_EARLYCHECKINMINUTES=15
